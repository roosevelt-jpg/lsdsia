# Local SQLite. On Vercel use a Postgres URL instead (and postgresql Prisma provider).
DATABASE_URL="file:./dev.db"

# Required — long random string for session cookies
AUTH_SECRET="replace-me-with-a-long-random-secret"
NEXTAUTH_SECRET="replace-me-with-a-long-random-secret"
NEXTAUTH_URL="http://127.0.0.1:3047"

# Stripe Checkout (test mode). App stays browsable if unset.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Seed accounts — passwords are required; seed fails if either is empty.
# Set your own values; do not commit real passwords.
ADMIN_EMAIL="admin@lifestar.academy"
ADMIN_PASSWORD=
DEMO_EMAIL="demo@lifestar.academy"
DEMO_PASSWORD=
