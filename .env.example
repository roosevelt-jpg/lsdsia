# Local SQLite (default). On Vercel, use a Postgres URL instead and set
# prisma/schema.prisma datasource provider to "postgresql".
DATABASE_URL="file:./dev.db"

# Required session signing secret (use a long random string in production)
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://127.0.0.1:3047"
NEXTAUTH_SECRET="replace-me"

# Stripe Checkout (test mode). App stays browsable if unset.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Seed accounts — REQUIRED for `npm run db:seed` (no hardcoded defaults)
ADMIN_EMAIL="admin@lifestar.academy"
ADMIN_PASSWORD="change-me"
DEMO_EMAIL="demo@lifestar.academy"
DEMO_PASSWORD="change-me"

# Production (Vercel) extras
# APP_URL="https://your-deployment.vercel.app"

# Certificate branding (optional — seed / SchoolSetting)
# PROGRAM_DIRECTOR_NAME="Alex Rivera"
# LSDS_SCHOOL_REGISTRATION_ID="LSDS-MN-REG-PENDING"
# LSDS_OPERATOR_LICENSE_ID="MN-OP-LICENSE-PENDING"

# Auth onboarding (optional)
# ADMIN_INVITE_CODE="your-admin-invite"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common
