generator client {
  provider      = "prisma-client-js"
  // native = local; rhel-openssl-3.0.x = Vercel Node serverless
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("candidate") // candidate | coach | admin
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             Profile?
  enrollments         Enrollment[]
  orders              Order[]
  entitlements        Entitlement[]
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]
  applicationPacket   ApplicationPacket?
  competencyRecords   CompetencyRecord[]
  practicumBookings   PracticumBooking[]
  auditLogs           AuditLog[]
  licenseVerification LicenseVerification?
  schoolLaunchPlan    SchoolLaunchPlan?
  privateUploads      PrivateUpload[]
  certificates        Certificate[]
  passwordResetTokens PasswordResetToken[]
}

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  phone           String?
  phoneCountry    String? @default("US")
  dateOfBirth     String?
  country         String? @default("United States")
  address1        String?
  address2        String?
  city            String?
  state           String?
  zip             String?
  /// Data URL or remote URL for admin/UI avatar (legacy)
  avatarUrl       String?
  /// PrivateUpload id for passport-style student ID photo (served via /api/private-uploads)
  idPhotoUploadId String?
  /// Onboarding wizard (1–5); 5 + profileCompletedAt means finished
  onboardingStep  Int     @default(0)
  trainingGoal    String?
  experienceLevel String?
  howHeard        String?
  additionalNotes String?
  profileCompletedAt DateTime?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EnrollmentLevel {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  enrollments       Enrollment[]
  lessonPrices      LessonPrice[]
  practicalPrices   PracticalPrice[]
  packages          LevelPackage[]
  learningMaterials LearningMaterial[]
}

model Enrollment {
  id               String    @id @default(cuid())
  userId           String
  levelId          String
  /// Human-readable Life Star ID, e.g. LS-2026-A7K3M2 — unique, stable, used as barcode value
  enrollmentNumber String    @unique
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  status           String    @default("active") // active | paused | completed

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  level       EnrollmentLevel @relation(fields: [levelId], references: [id])
  certificate Certificate?

  @@unique([userId, levelId])
}

model Module {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  sortOrder   Int      @default(0)
  lessons     Lesson[]
}

model Lesson {
  id           String          @id @default(cuid())
  moduleId     String
  slug         String
  title        String
  summary      String
  bodyMarkdown String
  sortOrder    Int             @default(0)
  module       Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  prices       LessonPrice[]
  progress     LessonProgress[]
  entitlements Entitlement[]
  orderItems   OrderItem[]

  @@unique([moduleId, slug])
}

model LessonPrice {
  id          String          @id @default(cuid())
  lessonId    String
  levelId     String
  amountCents Int
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  level       EnrollmentLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([lessonId, levelId])
}

model PracticalSku {
  id                  String           @id @default(cuid())
  code                String           @unique
  name                String
  description         String
  durationDays        Int              @default(5)
  locationNote        String           @default("Life Star Driving School — Minnesota main campus")
  /// Percent of full tuition due at checkout (remainder billed on the installment plan).
  downPaymentPercent  Int              @default(50)
  /// Months to spread the balance after the down payment (0 = pay in full at checkout).
  installmentMonths   Int              @default(0)
  prices              PracticalPrice[]
  entitlements        Entitlement[]
  orderItems          OrderItem[]
  sessions            PracticumSession[]
  packages            LevelPackage[]
}

model PracticalPrice {
  id             String          @id @default(cuid())
  practicalSkuId String
  levelId        String
  amountCents    Int
  practicalSku   PracticalSku    @relation(fields: [practicalSkuId], references: [id], onDelete: Cascade)
  level          EnrollmentLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([practicalSkuId, levelId])
}

model LevelPackage {
  id                     String       @id @default(cuid())
  levelId                String
  name                   String
  description            String
  amountCents            Int
  includesAllLessons     Boolean      @default(true)
  includesPracticalSkuId String?
  level                  EnrollmentLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  includesPracticalSku   PracticalSku?   @relation(fields: [includesPracticalSkuId], references: [id])
  orderItems             OrderItem[]
}

model Order {
  id                    String        @id @default(cuid())
  userId                String
  status                String        @default("pending") // pending | paid | refunded | canceled
  totalCents            Int
  taxCents              Int           @default(0)
  currency              String        @default("usd")
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  paidAt                DateTime?
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 OrderItem[]
  entitlements          Entitlement[]
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  type           String // lesson | practical | package
  label          String
  amountCents    Int
  lessonId       String?
  practicalSkuId String?
  packageId      String?
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lesson         Lesson?       @relation(fields: [lessonId], references: [id])
  practicalSku   PracticalSku? @relation(fields: [practicalSkuId], references: [id])
  package        LevelPackage? @relation(fields: [packageId], references: [id])
}

model Entitlement {
  id               String        @id @default(cuid())
  userId           String
  lessonId         String?
  practicalSkuId   String?
  creditsRemaining Int           @default(0)
  sourceOrderId    String?
  createdAt        DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson           Lesson?       @relation(fields: [lessonId], references: [id])
  practicalSku     PracticalSku? @relation(fields: [practicalSkuId], references: [id])
  sourceOrder      Order?        @relation(fields: [sourceOrderId], references: [id])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime?
  percent     Int       @default(0)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

/// Admin-managed video / document links shown to enrolled candidates on their dashboard.
model LearningMaterial {
  id           String           @id @default(cuid())
  title        String
  description  String           @default("")
  url          String
  kind         String           @default("video") // video | document | link
  /// null = available to every enrolled level
  levelId      String?
  thumbnailUrl String?
  sortOrder    Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  level        EnrollmentLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)
}

model Quiz {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  description      String
  passPercent      Int           @default(80)
  timeLimitMinutes Int?          @default(240)
  questions        Question[]
  attempts         QuizAttempt[]
}

model Question {
  id               String          @id @default(cuid())
  quizId           String
  number           Int
  prompt           String
  type             String // multiple_choice | short_answer
  choicesJson      String?
  correctIndex     Int?
  acceptedKeywords String?
  explanation      String
  topic            String
  /// Admin-only answer-key slideshow (never shown to candidates)
  inAdminSlides    Boolean         @default(false)
  quiz             Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers          AttemptAnswer[]

  @@unique([quizId, number])
}

model QuizAttempt {
  id           String          @id @default(cuid())
  userId       String
  quizId       String
  startedAt    DateTime        @default(now())
  submittedAt  DateTime?
  scorePercent Int?
  passed       Boolean?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      AttemptAnswer[]
}

model AttemptAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  response   String
  isCorrect  Boolean     @default(false)
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model ApplicationPacket {
  id                       String               @id @default(cuid())
  userId                   String               @unique
  fullName                 String?
  birthDate                String?
  address1                 String?
  address2                 String?
  city                     String?
  state                    String?
  zip                      String?
  dlNumber                 String?
  ssnLast4                 String?
  phone                    String?
  employingSchoolName      String?              @default("Life Star Driving School")
  employingSchoolAddress   String?              @default("Minnesota main campus")
  classroomCompetencyDate  String?
  laboratoryCompetencyDate String?
  educationProvider        String?
  educationLocation        String?
  applicantCertified       Boolean              @default(false)
  privacyAcknowledged      Boolean              @default(false)
  completenessPercent      Int                  @default(0)
  updatedAt                DateTime             @updatedAt
  createdAt                DateTime             @default(now())
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents                ApplicationDocument[]
}

model ApplicationDocument {
  id        String            @id @default(cuid())
  packetId  String
  kind      String
  fileName  String
  filePath  String
  createdAt DateTime          @default(now())
  packet    ApplicationPacket @relation(fields: [packetId], references: [id], onDelete: Cascade)
}

model CompetencyRecord {
  id             String  @id @default(cuid())
  userId         String
  classroomDate  String?
  laboratoryDate String?
  provider       String  @default("Life Star Driving School")
  notes          String?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PracticumSession {
  id               String             @id @default(cuid())
  practicalSkuId   String
  title            String
  /// YYYY-MM-DD (inclusive)
  startDate        String
  /// YYYY-MM-DD (inclusive)
  endDate          String
  /// Optional local times HH:mm for campus day blocks
  startTime        String?
  endTime          String?
  capacity         Int                @default(8)
  /// practicum | class | campus | info
  kind             String             @default("practicum")
  location         String             @default("7240 Brooklyn Blvd, Minneapolis, MN")
  instructorName   String?
  notes            String?
  practicalSku     PracticalSku       @relation(fields: [practicalSkuId], references: [id], onDelete: Cascade)
  bookings         PracticumBooking[]
}

model PracticumBooking {
  id        String   @id @default(cuid())
  userId    String
  sessionId String
  status    String   @default("requested") // not_eligible | eligible | payment_required | requested | confirmed | completed | canceled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  adminNote String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   PracticumSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metaJson  String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model SchoolSetting {
  id                   String @id @default("default")
  name                 String @default("Life Star Driving School")
  address              String @default("Minnesota main campus")
  supportEmail         String @default("academy@lifestardrivingschool.example")
  supportPhone         String @default("(651) 555-0147")
  /// Display name for Program Director signature on certificates (admin-editable)
  programDirectorName  String @default("Alex Rivera")
  /// Placeholder until official MN registration IDs are confirmed — edit in admin or seed
  schoolRegistrationId String @default("LSDS-MN-REG-PENDING")
  operatorLicenseId    String @default("MN-OP-LICENSE-PENDING")
}

/// Digital completion certificate for Instructor Academy graduates
model Certificate {
  id                String    @id @default(cuid())
  /// Public verification code, e.g. LSDS-C-A7K3M2XQ
  verificationCode  String    @unique
  userId            String
  enrollmentId      String    @unique
  studentName       String
  enrollmentNumber  String
  programName       String
  completedAt       DateTime
  issuedAt          DateTime  @default(now())
  issuedById        String?
  ownerSignatory    String
  directorSignatory String
  revokedAt         DateTime?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
}

/// Private binary stored in DB (not under public/). Used for DL + school-launch docs on Vercel.
model PrivateUpload {
  id         String   @id @default(cuid())
  userId     String
  kind       String // drivers_license | passport_photo | travel_passport | student_id_photo | school_launch_*
  fileName   String
  mimeType   String
  dataBase64 String
  byteSize   Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LicenseVerification {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  status                 String    @default("not_submitted") // not_submitted | pending | approved | rejected
  /// PrivateUpload id — government driver’s license
  uploadId               String?
  /// PrivateUpload id — passport-style face photo
  passportPhotoUploadId  String?
  /// PrivateUpload id — travel passport bio page / copy
  travelPassportUploadId String?
  licenseNumber          String?
  licenseState           String?
  passportNumber         String?
  adminNote              String?
  reviewedById           String?
  reviewedAt             DateTime?
  submittedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolLaunchPlan {
  id            String                 @id @default(cuid())
  userId        String                 @unique
  targetState   String?
  schoolName    String?
  status        String                 @default("not_started") // not_started | in_progress | docs_submitted | coaching | completed
  checklistJson String                 @default("{}")
  adminNote     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     SchoolLaunchDocument[]
}

model SchoolLaunchDocument {
  id         String           @id @default(cuid())
  planId     String
  kind       String // state_application | bond_insurance | entity_docs | facility | instructor_roster | other
  uploadId   String?
  label      String
  createdAt  DateTime         @default(now())
  plan       SchoolLaunchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

/// Marketing CMS — site-wide chrome + contact
model CmsSite {
  id              String @id @default("default")
  brandName       String @default("LIFE STAR INSTRUCTORS ACADEMY")
  tagline         String @default("International Driving Instructor Training & Licensing")
  /// Exact logo assets from ChatGPT mockups (admin-replaceable)
  logoUrl         String @default("/cms/logo-full-light.png")
  logoMarkUrl     String @default("/cms/logo-mark.svg")
  headerTagline   String @default("International Driving Instructor Training & Licensing")
  headerMetaLeft  String @default("Worldwide Online Learning")
  headerMetaRight String @default("Minnesota Campus, USA")
  applyCtaLabel   String @default("Apply Now")
  applyCtaHref    String @default("/signup")
  loginCtaLabel   String @default("Login")
  /// Theme tokens: navy, amber, gradients, button colors (JSON)
  themeJson       String @default("{\"navy\":\"#0B1F33\",\"navyDeep\":\"#061526\",\"amber\":\"#E6A817\",\"amberHot\":\"#F0B92A\",\"heroGradient\":\"linear-gradient(115deg,#061526 0%,#0B3A6E 55%,#1256A0 100%)\",\"ctaGradient\":\"linear-gradient(115deg,#0B3A6E 0%,#1256A0 100%)\",\"primaryBtnBg\":\"#E6A817\",\"primaryBtnText\":\"#061526\",\"secondaryBtnBorder\":\"#FFFFFF\",\"secondaryBtnText\":\"#FFFFFF\"}")
  contactAddress  String @default("7240 Brooklyn Blvd, Minneapolis, MN 55429, United States")
  contactPhone    String @default("+1 763-390-7637")
  contactEmail    String @default("info@lifestarinstructorsacademy.com")
  ownerName       String @default("John Addo")
  footerBlurb     String @default("International driving instructor training, licensing preparation and driving school business support.")
  copyrightText   String @default("© 2025 Life Star Instructors Academy. All Rights Reserved.")
  privacyHref     String @default("/resources#privacy")
  termsHref       String @default("/resources#terms")
  refundHref      String @default("/resources#refund")
  socialJson      String @default("[]")
  /// Footer column menus (Programs / Admissions / Students / About) — JSON array
  footerNavJson   String @default("[]")
  searchEnabled   Boolean @default(true)
  newsletterBlurb String @default("Get training updates, new courses and special offers.")
  contentVersion  Int     @default(2)
  /// Candidate dashboard CMS banners (admin-replaceable; support /cms/... or cms:mediaKey)
  dashboardTagline           String @default("Learn Globally. Train Professionally. Lead Confidently.")
  dashboardHeroBgUrl         String @default("/cms/dashboard/hero-bg-hires.jpg")
  dashboardHeroPersonUrl     String @default("/cms/dashboard/hero-person.jpg")
  dashboardUpgradeImageUrl   String @default("/cms/dashboard/upgrade-car.jpg")
  dashboardContinueThumbUrl  String @default("/cms/dashboard/continue-lesson.jpg")
  dashboardHeroSubtitle      String @default("Continue your journey to becoming a certified driving instructor with Life Star Instructors Academy.")
  dashboardUpgradeTitle      String @default("Upgrade to Instructor Pro")
  dashboardUpgradeBody       String @default("Advanced Courses\nBusiness Launch Toolkit\n1-on-1 Mentorship")
  dashboardUpgradeCtaLabel   String @default("Upgrade Now")
  dashboardUpgradeCtaHref    String @default("/app/store")
  dashboardHeroCtaLabel      String @default("Continue Learning")
  dashboardHeroCtaHref       String @default("/app/learn")
  dashboardHeroSecondaryLabel String @default("View My Progress")
  dashboardHeroSecondaryHref  String @default("/app")
  /// Super-admin dashboard CMS banners (replaceable anytime)
  adminHeroTitle             String @default("Welcome to Life Star Instructors Academy")
  adminHeroSubtitle          String @default("Manage training, students, instructors and academy operations all in one place.")
  adminHeroBgUrl             String @default("/cms/admin/hero-banner.jpg")
  adminHeroPersonUrl         String @default("/cms/admin/hero-person-hires.jpg")
  adminPromoTitle            String @default("Grow Your Driving School")
  adminPromoBody             String @default("Expand campus capacity, launch new cohorts, and scale instructor training.")
  adminPromoImageUrl         String @default("/cms/admin/promo-grow.jpg")
  adminPromoCtaLabel         String @default("Learn More")
  adminPromoCtaHref          String @default("/admin/school-launch")
  adminHeroCtaPrimaryLabel   String @default("New Enrollment")
  adminHeroCtaPrimaryHref    String @default("/admin/candidates")
  adminHeroCtaSecondaryLabel String @default("View Reports")
  adminHeroCtaSecondaryHref  String @default("/admin")
  adminHeroCtaTertiaryLabel  String @default("Manage Courses")
  adminHeroCtaTertiaryHref   String @default("/admin/content")
}

model CmsNavItem {
  id        String  @id @default(cuid())
  label     String
  href      String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

/// CMS pages: home + Programs / Admissions / Students / Resources / About
model CmsPage {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  metaDescription String  @default("")
  heroBadge       String  @default("")
  heroTitle       String  @default("")
  heroSubtitle    String  @default("")
  heroImageUrl    String  @default("")
  bodyMarkdown    String  @default("")
  ctaPrimaryLabel String  @default("")
  ctaPrimaryHref  String  @default("")
  ctaSecondaryLabel String @default("")
  ctaSecondaryHref  String @default("")
  published       Boolean @default(true)
  sortOrder       Int     @default(0)
  sections        CmsSection[]
}

model CmsSection {
  id           String  @id @default(cuid())
  pageId       String
  key          String // hero | programs | trusted | stats | testimonials | cta | custom
  eyebrow      String  @default("")
  title        String  @default("")
  subtitle     String  @default("")
  body         String  @default("")
  imageUrl     String  @default("")
  ctaLabel     String  @default("")
  ctaHref      String  @default("")
  dataJson     String  @default("{}")
  sortOrder    Int     @default(0)
  published    Boolean @default(true)
  page         CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
}

model CmsProgramCard {
  id        String  @id @default(cuid())
  title     String
  blurb     String
  imageUrl  String  @default("")
  href      String  @default("/programs")
  iconKey   String  @default("graduation")
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model CmsStat {
  id        String  @id @default(cuid())
  value     String
  label     String
  iconKey   String  @default("users")
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model CmsTestimonial {
  id        String  @id @default(cuid())
  quote     String
  name      String
  title     String
  photoUrl  String  @default("")
  stars     Int     @default(5)
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

/// Public marketing media (admin uploads replace placeholders)
model CmsMedia {
  id         String   @id @default(cuid())
  key        String   @unique // e.g. hero_image, program_1
  label      String
  fileName   String
  mimeType   String
  dataBase64 String
  byteSize   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
